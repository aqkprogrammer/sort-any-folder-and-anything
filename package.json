{
  "name": "photo-sorter",
  "productName": "Photo Sorter",
  "version": "2.0.0",
  "description": "Watch a messy folder of photos, videos and documents sort itself. On-device AI, no uploads.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "web": "python3 scripts/serve.py 8765",
    "smoke": "electron . --smoke",
    "screenshots": "electron . --tour",
    "dist": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.aqkprogrammer.photosorter",
    "productName": "Photo Sorter",
    "files": [
      "index.html",
      "src/**",
      "electron/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    }
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  }
}
